# Copy to .env for local work. On Netlify, add these under Site configuration > Environment variables.
# Both values are on Supabase: Project Settings > API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only (Netlify Functions, added in Week 3). Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
